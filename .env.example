# Returnly Environment Configuration Sample
# Copy to .env for local overrides or configure in your hosting provider for production deployment.

# Optional in local dev (uses local PGlite in .data/pglite automatically);
# Required in production serverless/container deployments:
DATABASE_URL=

# Required in production deployments (generate via `openssl rand -hex 32`):
BETTER_AUTH_SECRET=

# Optional LLM Provider Keys for AgentSidebar Chat:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
